# Memento Mori — Environment Variables
# Copy to .env and fill in values

# === OpenRouter (LLM) ===
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# === Engine Auth (JWT) ===
# Secret used to sign and validate JWTs on /mcp. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Admin API key for POST /api/admin/npc-jwt (mints NPC JWTs). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_ADMIN_KEY=

# === Bonfires (Knowledge Graph) ===
BONFIRE_API_KEY=
BONFIRE_ID=
BONFIRE_AGENT_ID=
BONFIRE_BASE_URL=https://tnt-v2.api.bonfires.ai

# === Matrix (Multiplayer Transport) ===
MATRIX_HOMESERVER=http://localhost:8008
MATRIX_BOT_TOKEN=
MATRIX_DOMAIN=localhost

# === Pinata (IPFS) ===
PINATA_JWT=

# === Chain (Redstone L2 — optional) ===
# Characters, Deaths, Items written onchain. Epoch state roots committed periodically.
REDSTONE_RPC=http://localhost:8545
MUD_WORLD_ADDRESS=
ENGINE_PRIVATE_KEY=

# === Epoch Config ===
# EPOCH_ENABLED=true          # Enable epoch commits (default: true if chain enabled)
# EPOCH_INTERVAL_TICKS=0      # 0 = commit only at session boundaries

# --- cxn control system (Day-1 skeleton) ---
KERNEL_BASE_URL=http://localhost:8001   # graph-memory service base URL
GM_INTERNAL_TOKEN=                       # shared internal bearer for kernel/index|search
MONGO_URI=mongodb://localhost:27017      # transactional StateRepository (optional Day 1; default is in-memory)
MONGO_DB=memento                         # state db name
CHAIN_ENABLED=false                      # NoopChainMirror when false
