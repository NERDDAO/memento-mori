# Memento Mori — Environment Variables
# Copy to .env and fill in values

# === LLM ===
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# === Bonfires (Knowledge Graph) ===
BONFIRE_API_KEY=
BONFIRE_ID=
BONFIRE_AGENT_ID=
BONFIRE_BASE_URL=https://tnt-v2.api.bonfires.ai

# === Matrix (Multiplayer Transport) ===
MATRIX_HOMESERVER=http://localhost:8008
MATRIX_BOT_TOKEN=
MATRIX_DOMAIN=localhost

# === Chain (Redstone L2) ===
REDSTONE_RPC=http://localhost:8545
MUD_WORLD_ADDRESS=
ENGINE_PRIVATE_KEY=
MUD_INDEXER_URL=http://localhost:3001

# === x402 Payments ===
X402_ENABLED=false
X402_PRICE_USDC=3000000
X402_RECIPIENT_ADDRESS=
X402_USDC_ON_REDSTONE=

# === Redis (Production) ===
REDIS_URL=redis://localhost:6379/0

# === Domain ===
PUBLIC_DOMAIN=localhost
