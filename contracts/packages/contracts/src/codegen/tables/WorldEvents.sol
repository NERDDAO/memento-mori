    StoreCore.setRecord(_tableId, _keyTuple, _staticData, _encodedLengths, _dynamicData, _fieldLayout);
  }

  /**
   * @notice Decode the tightly packed blob of static data using this table's field layout.
   */
  function decodeStatic(
    bytes memory _blob
  ) internal pure returns (EventType eventType, uint256 tick, uint256 timestamp) {
    eventType = EventType(uint8(Bytes.getBytes1(_blob, 0)));

    tick = (uint256(Bytes.getBytes32(_blob, 1)));

    timestamp = (uint256(Bytes.getBytes32(_blob, 33)));
  }

  /**
   * @notice Decode the tightly packed blob of dynamic data using the encoded lengths.
   */
  function decodeDynamic(
    EncodedLengths _encodedLengths,
    bytes memory _blob
  ) internal pure returns (string memory actors, string memory location, string memory summary) {
